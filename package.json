{
  "name": "totp-authenticator",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Zero-network, offline-first RFC 6238 2FA TOTP authenticator for Web (PWA) and Telegram Mini App built with native WebCrypto",
  "repository": {
    "type": "git",
    "url": "https://github.com/qilaidev/totp-authenticator.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx --yes serve out",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "next": "16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
